<div class="h-screen w-screen bg-slate-50 flex items-center justify-center p-4">
  <div class="max-w-xl w-full bg-white p-8 rounded-3xl shadow-xl border border-gray-100 text-center space-y-6">
    <div class="inline-flex p-4 bg-emerald-50 text-emerald-600 rounded-full">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
      </svg>
    </div>

    <div>
      <h1 class="text-2xl font-bold text-gray-900">Ton fichier PDF est prêt !</h1>
      <p class="text-sm text-gray-500 mt-1">L'image a été cadrée et adaptée au format PDF A4.</p>
    </div>

    <div class="pt-4 space-y-3">
      <% if @conversion.pdf_file.attached? %>
        <%= link_to rails_blob_path(@conversion.pdf_file, disposition: "attachment"), class: "inline-flex items-center justify-center gap-2 w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-6 rounded-xl shadow-lg shadow-emerald-200 transition-all text-base" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          <span>Télécharger le PDF</span>
        <% end %>
      <% end %>

      <%= link_to new_conversion_path, class: "inline-block text-sm font-semibold text-gray-500 hover:text-indigo-600 transition-colors pt-2" do %>
        ← Convertir une autre image
      <% end %>
    </div>
  </div>
</div>