<div class="min-h-screen bg-slate-50 flex flex-col justify-between items-center w-full font-sans">
  
  <!-- Navbar Header -->
  <header class="w-full bg-white border-b border-gray-100 py-4 px-6 sm:px-12 flex justify-between items-center shadow-sm">
    <div class="flex items-center gap-3">
      <div class="p-2.5 bg-indigo-600 rounded-xl text-white shadow-md shadow-indigo-200">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
        </svg>
      </div>
      <span class="text-xl font-extrabold text-gray-900 tracking-tight">PDF<span class="text-indigo-600">Convert</span></span>
    </div>

    <div class="flex items-center gap-3">
      <span class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 bg-emerald-50 text-emerald-700 text-xs font-semibold rounded-full border border-emerald-200">
        <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
        100% En ligne & Gratuit
      </span>
    </div>
  </header>

  <!-- Section Principale / Carte Centrée -->
  <main class="w-full flex-grow flex items-center justify-center p-6 py-12">
    <div class="max-w-3xl w-full bg-white p-8 sm:p-12 rounded-3xl shadow-xl border border-gray-100 space-y-8 mx-auto">
      
      <!-- Titre principal -->
      <div class="text-center space-y-2">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">Convertisseur Universel en PDF</h1>
        <p class="text-base text-gray-500 max-w-lg mx-auto">Transforme instantanément tes images (JPG, PNG) et tes fichiers de données (DAT, TXT) en documents PDF haute définition.</p>
      </div>

      <%= form_with(model: @conversion, class: "space-y-6") do |f| %>
        <% if @conversion.errors.any? %>
          <div class="p-4 bg-rose-50 text-rose-700 rounded-2xl text-sm font-medium">
            Veuillez sélectionner un fichier valide.
          </div>
        <% end %>

        <!-- Sélection du format -->
        <div class="bg-gray-50 p-4 rounded-2xl border border-gray-100">
          <%= f.label :orientation, "Format & Orientation de sortie :", class: "block text-sm font-bold text-gray-700 mb-2" %>
          <%= f.select :orientation, 
                       [["A4 Portrait (Standard)", "portrait"], ["A4 Paysage (Landscape)", "landscape"], ["Plein écran sur-mesure (Taille réelle)", "fit"]], 
                       {}, 
                       class: "w-full rounded-xl border-gray-300 shadow-sm p-3 bg-white border text-sm font-semibold text-gray-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none" %>
        </div>

        <!-- Zone d'upload Agrandie -->
        <div class="flex justify-center px-8 pt-10 pb-10 border-2 border-indigo-200 border-dashed rounded-3xl hover:border-indigo-500 transition-all bg-indigo-50/20 group cursor-pointer">
          <div class="space-y-3 text-center w-full">
            <div class="p-4 bg-indigo-50 text-indigo-600 rounded-full inline-block group-hover:scale-110 transition-transform">
              <svg class="h-10 w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0l-4 4m4-4v12"/>
              </svg>
            </div>
            
            <div class="flex text-base text-gray-600 justify-center font-medium">
              <label for="image-upload" class="relative cursor-pointer bg-white rounded-xl font-bold text-indigo-600 hover:text-indigo-500 focus-within:outline-none px-3 py-1.5 shadow-sm border border-indigo-100">
                <span>Parcourir mes fichiers</span>
                <%= f.file_field :image, id: "image-upload", class: "sr-only", required: true %>
              </label>
              <p class="pl-2 py-1">ou glisser-déposer ici</p>
            </div>

            <!-- Affichage du fichier sélectionné -->
            <p id="file-name-display" class="text-sm font-bold text-indigo-600 pt-1">Aucun fichier sélectionné</p>
            <p class="text-xs text-gray-400">Tous types de fichiers acceptés (Images JPG, PNG, DAT, TXT...) jusqu'à 10 Mo</p>
          </div>
        </div>

        <!-- Bouton de soumission -->
        <div>
          <%= f.submit "Convertir mon fichier en PDF 🚀", class: "w-full cursor-pointer bg-indigo-600 hover:bg-indigo-700 text-white font-extrabold py-4 px-6 rounded-2xl shadow-xl shadow-indigo-200 hover:shadow-indigo-300 transition-all text-lg" %>
        </div>
      <% end %>

    </div>
  </main>

  <!-- Section Avantages Centrée -->
  <section class="max-w-5xl w-full mx-auto px-6 pb-12 grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
    <div class="p-5 bg-white rounded-2xl border border-gray-100 shadow-sm">
      <div class="text-indigo-600 font-bold text-lg mb-1">⚡ Conversion Instantanée</div>
      <p class="text-xs text-gray-500">Génération du PDF en moins de 2 secondes grâce à notre moteur Ruby Prawn.</p>
    </div>
    <div class="p-5 bg-white rounded-2xl border border-gray-100 shadow-sm">
      <div class="text-emerald-600 font-bold text-lg mb-1">🔒 100% Sécurisé</div>
      <p class="text-xs text-gray-500">Tes fichiers ne sont pas conservés et restent confidentiels.</p>
    </div>
    <div class="p-5 bg-white rounded-2xl border border-gray-100 shadow-sm">
      <div class="text-amber-600 font-bold text-lg mb-1">📐 Sur-Mesure</div>
      <p class="text-xs text-gray-500">Choisis l'orientation Portrait, Paysage ou Taille réelle en un clic.</p>
    </div>
  </section>

  <!-- Footer Centré -->
  <footer class="w-full bg-white border-t border-gray-100 py-4 text-center text-xs text-gray-400">
    © <%= Time.current.year %> PDFConvert — Fait avec Ruby on Rails & Tailwind CSS
  </footer>

</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const fileInput = document.getElementById("image-upload");
    const fileNameDisplay = document.getElementById("file-name-display");

    fileInput.addEventListener("change", (e) => {
      if (e.target.files.length > 0) {
        fileNameDisplay.textContent = `Fichier sélectionné : ${e.target.files[0].name}`;
        fileNameDisplay.classList.add("text-emerald-600");
        fileNameDisplay.classList.remove("text-indigo-600");
      } else {
        fileNameDisplay.textContent = "Aucun fichier sélectionné";
      }
    });
  });
</script>